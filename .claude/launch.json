{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sapi-laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8000"],
      "port": 8000
    },
    {
      "name": "sapi-laravel-8001",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8001"],
      "port": 8001
    },
    {
      "name": "sapi-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "sapi-queue",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "queue:listen", "--tries=1"],
      "port": 0
    }
  ]
}
