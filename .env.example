APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona waktu bisnis: satu untuk seluruh aplikasi ([BL-082]).
# WIB=Asia/Jakarta, WITA=Asia/Makassar, WIT=Asia/Jayapura.
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sapi_smart_ai_pos_inventory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_EXPIRY=525600
SANCTUM_TOKEN_PREFIX=

ADMIN_EMAIL=admin@sapi.com
ADMIN_INITIAL_PASSWORD=

# Payment gateway langganan (BL-059). `fake` = gateway tiruan untuk development
# dan peragaan; ia GAGAL di-resolve di lingkungan produksi, bukan diam-diam
# jatuh ke jalur manual. SUMOPOD_API_KEY di bawah adalah kunci AI, BUKAN
# pembayaran — jangan dipakai ulang (BL-060).
PAYMENT_DRIVER=fake
PAYMENT_FAKE_SECRET=sapi-fake-gateway
# Detik sampai "pembayaran" datang sendiri di halaman instruksi. 0 = mati,
# dan keadaannya hanya bergerak lewat panel alat pengembangan.
PAYMENT_FAKE_AUTO_SETTLE_SECONDS=8

# AI Analysis (BYOK per-tenant + shared free tier)
AI_DEFAULT_PROVIDER=sumopod
SUMOPOD_API_KEY=
AI_SUMOPOD_MODEL=gpt-4o-mini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Shared free-tier key memakai provider = AI_DEFAULT_PROVIDER (mis. SumoPod)
AI_FREE_TIER_KEY=
AI_FREE_TIER_DAILY_LIMIT=5

# Panel Platform (pemilik SaaS) — akun pertama dibuat PlatformUserSeeder.
# WAJIB diisi sebelum menjalankan seeder di server sungguhan: di luar APP_ENV
# lokal, seeder menolak jalan bila PLATFORM_ADMIN_PASSWORD kosong.
PLATFORM_ADMIN_NAME="Pemilik Platform"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Tujuan peringatan operasional (percobaan masuk menumpuk, pendaftaran berulang).
# Kosongkan untuk mengirim ke semua akun platform bertanda is_owner. Isi bila
# peringatan sebaiknya masuk ke kotak surel operasional, bukan kotak pribadi.
PLATFORM_ALERT_EMAIL=

# CATATAN: peringatan dan verifikasi email dikirim lewat MAIL_MAILER di atas.
# Dengan MAIL_MAILER=log surelnya hanya masuk storage/logs — cukup untuk lokal,
# tapi di server sungguhan tenant baru tak akan pernah bisa memverifikasi
# alamatnya sampai SMTP diisi.
